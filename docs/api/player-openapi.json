{
 "openapi": "3.1.0",
 "info": {
  "title": "Plenio Player API",
  "version": "1.0",
  "description": "A small, stable set of the Plenio Player's routes for remote controls, stream decks and home automation. This computer needs nothing; another device logs in to the player (its session cookie). Requests that change something send JSON. Commands reach the page that plays; the player's page plays the music, so a command needs an open player page."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:8765"
  }
 ],
 "paths": {
  "/api/v1": {
   "get": {
    "operationId": "index",
    "summary": "The API's name, version and paths",
    "responses": {
     "200": {
      "description": "the index",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Index"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/openapi.json": {
   "get": {
    "operationId": "openapi",
    "summary": "This document",
    "responses": {
     "200": {
      "description": "OpenAPI 3.1"
     }
    }
   }
  },
  "/api/v1/now": {
   "get": {
    "operationId": "now",
    "summary": "The song that plays, the position, the next three",
    "responses": {
     "200": {
      "description": "what the page that plays reported",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Now"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/transport": {
   "post": {
    "operationId": "transport",
    "summary": "Play, pause, toggle, next, previous or seek",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Transport"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "sent to the page that plays; it acts within a second",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Sent"
        }
       }
      }
     },
     "409": {
      "description": "no player page is open for this account (code no_player)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/songs": {
   "get": {
    "operationId": "songs",
    "summary": "The library, searched as the page searches",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "description": "free words, field filters (genre:pop, bpm:>100, #party, is:fav ...), quotes, -"
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 500,
       "default": 50
      }
     }
    ],
    "responses": {
     "200": {
      "description": "the best matches first, then the newest",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Songs"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/queue": {
   "post": {
    "operationId": "queue",
    "summary": "Add a song to play next or at the end",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/QueueAdd"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "sent to the page that plays; it acts within a second",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Sent"
        }
       }
      }
     },
     "409": {
      "description": "no player page is open for this account (code no_player)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "no such song",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/live": {
   "get": {
    "operationId": "live",
    "summary": "Live Play: on or off, and its rules",
    "responses": {
     "200": {
      "description": "Live Play as the page that plays has it",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Live"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "post": {
    "operationId": "live_set",
    "summary": "Start or stop Live Play, or change its rules",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Live"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "sent to the page that plays; it acts within a second",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Sent"
        }
       }
      }
     },
     "409": {
      "description": "no player page is open for this account (code no_player)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/events": {
   "get": {
    "operationId": "events",
    "summary": "Server-Sent Events: now, queue, live, reaction",
    "description": "Each event has an id; reconnect with Last-Event-ID. The first event is a now.",
    "responses": {
     "200": {
      "description": "text/event-stream",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "503": {
      "description": "too many streams are open (code busy)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "400": {
      "description": "the request is not what the endpoint takes",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "from the network without a login of the player",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
       "code": {
        "type": "string",
        "enum": [
         "bad_request",
         "invalid_value",
         "missing_field",
         "not_found",
         "unauthorized",
         "no_player",
         "busy"
        ]
       },
       "message": {
        "type": "string"
       },
       "hint": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ]
     }
    },
    "required": [
     "error"
    ]
   },
   "Song": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "seconds": {
      "type": "number"
     },
     "created": {
      "type": "string"
     },
     "genre": {
      "type": "string"
     },
     "mood": {
      "type": "string"
     },
     "artist": {
      "type": "string"
     },
     "album": {
      "type": "string"
     },
     "audio": {
      "type": [
       "string",
       "null"
      ],
      "description": "the audio file's address on the player"
     },
     "cover": {
      "type": [
       "string",
       "null"
      ],
      "description": "the cover picture's address on the player"
     },
     "page": {
      "type": "string",
      "description": "the song's page (not for music made elsewhere)"
     }
    },
    "required": [
     "id",
     "title",
     "seconds"
    ]
   },
   "Live": {
    "type": "object",
    "properties": {
     "on": {
      "type": "boolean"
     },
     "insert": {
      "type": "string",
      "enum": [
       "next",
       "end",
       "random"
      ],
      "description": "where a new song goes"
     },
     "auto": {
      "type": "boolean",
      "description": "new songs from ComfyUI join by themselves"
     },
     "atEnd": {
      "type": "string",
      "enum": [
       "again",
       "wait"
      ],
      "description": "from the top again, or wait"
     }
    }
   },
   "Now": {
    "type": "object",
    "properties": {
     "page": {
      "type": "boolean",
      "description": "a player page reports (false: none is open)"
     },
     "playing": {
      "type": "boolean"
     },
     "song": {
      "oneOf": [
       {
        "$ref": "#/components/schemas/Song"
       },
       {
        "type": "null"
       }
      ]
     },
     "position": {
      "type": "number",
      "description": "seconds; estimated from the page's last report"
     },
     "duration": {
      "type": "number"
     },
     "next": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Song"
      },
      "maxItems": 3
     },
     "queue_length": {
      "type": "integer"
     },
     "live": {
      "oneOf": [
       {
        "$ref": "#/components/schemas/Live"
       },
       {
        "type": "null"
       }
      ]
     },
     "reported": {
      "type": "number",
      "description": "seconds since the page's last report"
     }
    },
    "required": [
     "page",
     "playing",
     "song",
     "next"
    ]
   },
   "Transport": {
    "type": "object",
    "properties": {
     "do": {
      "type": "string",
      "enum": [
       "play",
       "pause",
       "toggle",
       "next",
       "previous",
       "seek"
      ]
     },
     "seconds": {
      "type": "number",
      "minimum": 0,
      "description": "for seek: from the song's start"
     }
    },
    "required": [
     "do"
    ]
   },
   "QueueAdd": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "where": {
      "type": "string",
      "enum": [
       "next",
       "end"
      ],
      "default": "end"
     }
    },
    "required": [
     "id"
    ]
   },
   "Sent": {
    "type": "object",
    "properties": {
     "sent": {
      "type": "integer",
      "description": "the command's number"
     }
    },
    "required": [
     "sent"
    ]
   },
   "Songs": {
    "type": "object",
    "properties": {
     "songs": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Song"
      }
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "songs",
     "total"
    ]
   },
   "Index": {
    "type": "object",
    "properties": {
     "api": {
      "type": "string"
     },
     "version": {
      "type": "string"
     },
     "player": {
      "type": "string"
     },
     "paths": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
