// Windows version information of Plenio.vst3.
#include <winver.h>
#include "plenio_version.h"

1 ICON "plenio.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLENIO_VERSION_MAJOR,PLENIO_VERSION_MINOR,PLENIO_VERSION_PATCH,0
 PRODUCTVERSION PLENIO_VERSION_MAJOR,PLENIO_VERSION_MINOR,PLENIO_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Plenio"
            VALUE "FileDescription", "Plenio VST3: Plenio and Plenio ARA"
            VALUE "FileVersion", PLENIO_VERSION_STRING
            VALUE "InternalName", "Plenio"
            VALUE "LegalCopyright", "Licensed under the Apache License 2.0"
            VALUE "OriginalFilename", "Plenio.vst3"
            VALUE "ProductName", "Plenio VST3"
            VALUE "ProductVersion", PLENIO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
