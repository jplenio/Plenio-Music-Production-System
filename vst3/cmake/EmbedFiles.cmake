# cmake -DSOURCE_DIR=<folder> -DOUTPUT=<file.cpp> -P EmbedFiles.cmake
#
# Writes every file below SOURCE_DIR into OUTPUT as a byte array, with its path (from "/") and MIME type, for
# plenio::webui::find() (src/ui/webui_resources.h). A missing folder gives a page that says how to build the UI.

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "EmbedFiles.cmake needs SOURCE_DIR and OUTPUT")
endif()

function(mime_of path out)
    get_filename_component(ext "${path}" EXT)
    string(TOLOWER "${ext}" ext)
    if(ext MATCHES "\\.html$")
        set(m "text/html; charset=utf-8")
    elseif(ext MATCHES "\\.js$" OR ext MATCHES "\\.mjs$")
        set(m "text/javascript; charset=utf-8")
    elseif(ext MATCHES "\\.css$")
        set(m "text/css; charset=utf-8")
    elseif(ext MATCHES "\\.json$")
        set(m "application/json")
    elseif(ext MATCHES "\\.svg$")
        set(m "image/svg+xml")
    elseif(ext MATCHES "\\.png$")
        set(m "image/png")
    elseif(ext MATCHES "\\.woff2$")
        set(m "font/woff2")
    elseif(ext MATCHES "\\.ico$")
        set(m "image/x-icon")
    else()
        set(m "application/octet-stream")
    endif()
    set(${out} "${m}" PARENT_SCOPE)
endfunction()

set(body "// Generated by cmake/EmbedFiles.cmake from ${SOURCE_DIR}: do not edit.\n#include \"ui/webui_resources.h\"\n\nnamespace plenio::webui\n{\nnamespace\n{\n")
set(table "")
set(count 0)

if(EXISTS "${SOURCE_DIR}")
    file(GLOB_RECURSE files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
    list(SORT files)
else()
    set(files "")
endif()

if(files STREQUAL "")
    set(fallback "<!doctype html><html><body style=\"background:#14121a;color:#eee;font-family:sans-serif;padding:2em\"><h2>Plenio</h2><p>The web UI was not built. Run <code>npm install</code> and <code>npm run build</code> in <code>webui/</code>, then build the plug-in again.</p></body></html>")
    string(HEX "${fallback}" hex)
    string(LENGTH "${fallback}" size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "const unsigned char f0[] = {${bytes}};\n")
    string(APPEND table "    { \"/index.html\", f0, ${size}, \"text/html; charset=utf-8\" },\n")
    set(count 1)
else()
    foreach(rel IN LISTS files)
        file(READ "${SOURCE_DIR}/${rel}" hex HEX)
        file(SIZE "${SOURCE_DIR}/${rel}" size)
        if(size EQUAL 0)
            set(bytes "0x00")
        else()
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        endif()
        mime_of("${rel}" mime)
        string(APPEND body "const unsigned char f${count}[] = {${bytes}};\n")
        string(APPEND table "    { \"/${rel}\", f${count}, ${size}, \"${mime}\" },\n")
        math(EXPR count "${count} + 1")
    endforeach()
endif()

string(APPEND body "\nconst File table[] = {\n${table}};\n} // namespace\n\n")
string(APPEND body "const File* begin() { return table; }\nconst File* end() { return table + ${count}; }\n\n} // namespace plenio::webui\n")

# write only when changed, so that an unchanged UI does not rebuild the plug-in
set(write TRUE)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
    if(old STREQUAL body)
        set(write FALSE)
    endif()
endif()
if(write)
    file(WRITE "${OUTPUT}" "${body}")
endif()
