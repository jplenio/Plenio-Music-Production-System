{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plenio.record/1",
  "title": "Plenio release record",
  "description": "Written by Export Release next to the audio (<name>.plenio.json). Each entry of 'reports' is a plenio.report/1.",
  "type": "object",
  "required": ["schema", "created", "title", "versions", "documents", "reports", "audio", "files", "licences", "prompt", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "plenio.record/1" },
    "created": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "versions": {
      "type": "object",
      "required": ["plenio"],
      "additionalProperties": { "type": "string" }
    },
    "documents": {
      "type": "object",
      "propertyNames": { "enum": ["title", "style", "lyrics", "score", "artwork_prompt"] },
      "additionalProperties": {
        "type": "object",
        "required": ["state", "status", "sha256", "text"],
        "additionalProperties": false,
        "properties": {
          "state": { "enum": ["auto", "edited", "manual"] },
          "status": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "text": { "type": "string" }
        }
      }
    },
    "reports": { "type": "array", "items": { "type": "object", "required": ["schema", "kind", "status"] } },
    "audio": {
      "type": "object",
      "required": ["sample_rate", "items", "seconds", "loudness", "tags"],
      "properties": {
        "sample_rate": { "type": "integer", "minimum": 1 },
        "items": { "type": "integer", "minimum": 1 },
        "seconds": { "type": "number", "minimum": 0 },
        "loudness": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/loudness" } },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "role": { "enum": ["original", "cover", "sheet_music", "stem", "stem_midi", "subtitles"] },
          "stem": { "type": "string", "minLength": 1 },
          "notes": { "type": "integer", "minimum": 0 },
          "subtitles": { "enum": ["lines", "notes", "sung"] },
          "timing": { "enum": ["measured", "heard", "sung"] },
          "format": { "enum": ["flac", "mp3", "wav"] },
          "bits": { "type": ["integer", "null"] },
          "sample_rate": { "type": "integer", "minimum": 1 },
          "channels": { "type": "integer", "minimum": 1 },
          "seconds": { "type": "number", "minimum": 0 },
          "peak": { "type": "number", "minimum": 0 },
          "clipped_samples": { "type": "integer", "minimum": 0 },
          "converted_from_rate": { "type": "integer", "minimum": 1 },
          "audio_md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "project": { "enum": ["embedded"] }
        }
      }
    },
    "licences": { "type": "array", "items": { "type": "string" } },
    "timing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["take", "timing", "lines"],
        "properties": {
          "take": { "type": "string" },
          "timing": { "enum": ["measured", "heard"] },
          "warp": { "type": ["array", "null"] },
          "heard_from": {
            "description": "Since 1.2.1: what the lyrics ASR listened to - the take's vocal stem, or the song itself.",
            "enum": ["vocal stem", "the song"]
          },
          "lines": { "type": "array", "items": { "type": "object", "required": ["text", "start", "end", "units"] } },
          "sung": {
            "description": "What the take sings, as heard - laid out like its lyrics, with their section tags - and how far it follows them.",
            "type": "object",
            "required": ["text", "lines"],
            "properties": {
              "text": { "type": "string" },
              "lines": { "type": "array", "items": { "type": "object", "required": ["text", "start", "end", "units"] } },
              "written_heard": { "type": "number", "minimum": 0, "maximum": 1 },
              "extra_words": { "type": "integer", "minimum": 0 },
              "not_sung": { "type": "array", "items": { "type": "string" } },
              "sections": { "type": "array", "items": { "type": "object" } },
              "corrected": {
                "description": "Songs exported with Plenio 1.2.0's Check Sung Words (retired since): the words the writer model found misheard, each with the word heard. The lines and the text carry the corrections.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["line", "heard", "word"],
                  "properties": {
                    "line": { "type": "integer", "minimum": 1 },
                    "heard": { "type": "string" },
                    "word": { "type": "string" },
                    "sure": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "subtitles": {
      "description": "Since 1.1.0: whether lyrics subtitles were asked for, for how many takes they were made, and why not for the others.",
      "type": "object",
      "required": ["wanted", "takes"],
      "additionalProperties": false,
      "properties": {
        "wanted": { "type": "boolean" },
        "takes": { "type": "integer", "minimum": 0 },
        "why": { "type": "array", "items": { "type": "string" } }
      }
    },
    "quality": {
      "description": "Since 1.4.0: how well the song came out, measured from its sound and its record (plenio.core.quality) - the stars 0-5 in halves, how good it sounds (0-1), every measure with its part, and the measures. A hint where to listen first, not the verdict. Not part of the fingerprint.",
      "type": "object",
      "required": ["version", "stars"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "stars": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "value", "score", "weight"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "value": { "type": "string" },
              "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "weight": { "type": "number", "minimum": 0 },
              "note": { "type": "string" },
              "kind": { "enum": ["quality", "fault"] }
            }
          }
        },
        "measures": { "type": "object", "additionalProperties": { "type": ["number", "boolean"] } }
      }
    },
    "made": {
      "description": "Since 1.4.0: how the song was made - when its run began and ended, how long it took, on what (the graphics card and its memory or the processor, the RAM), the lyrics fidelity. Not part of the fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "started": { "type": ["string", "null"] },
        "finished": { "type": "string" },
        "seconds": { "type": ["number", "null"], "minimum": 0 },
        "on": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device": { "type": "string" },
            "gpu": { "type": "string" },
            "vram_gb": { "type": "number" },
            "cpu": { "type": "string" },
            "cores": { "type": ["integer", "null"] },
            "ram_gb": { "type": "number" }
          }
        },
        "lyrics_fidelity": { "type": "string" }
      }
    },
    "models": {
      "description": "Since 2.0: the file each Model Choice of the prompt chose, by prompt node id (the prompt says only auto).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["component", "file"],
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "timings": {
      "description": "Since 2.0: where the run's time went (plenio.timings/1) - seconds per stage (a group of the template), the part of it spent loading models, the peak memory ComfyUI held on its graphics card. Not part of the fingerprint.",
      "type": "object",
      "required": ["schema", "total_seconds", "stages"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "plenio.timings/1" },
        "total_seconds": { "type": "number", "minimum": 0 },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "seconds"],
            "additionalProperties": false,
            "properties": {
              "stage": { "type": "string", "minLength": 1 },
              "seconds": { "type": "number", "minimum": 0 },
              "load_seconds": { "type": "number", "minimum": 0 },
              "model": { "type": "string" }
            }
          }
        },
        "peak_vram_gib": { "type": "number", "minimum": 0 }
      }
    },
    "sheet_music": {
      "type": "object",
      "required": ["file", "status"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "paper": { "type": "string" },
        "size": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "workflow": {
      "description": "The workflow the run was queued with (secrets redacted): opening the record continues the song in it.",
      "type": "object",
      "required": ["nodes"],
      "properties": { "nodes": { "type": "array" } }
    },
    "prompt": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class_type": { "type": "string" },
          "inputs": { "type": "object" },
          "_meta": { "type": "object" }
        }
      }
    },
    "fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "loudness": {
      "type": "object",
      "required": ["integrated_lufs", "true_peak_dbtp", "sample_peak_dbfs", "loudness_range_lu", "plr_db", "seconds", "meter", "valid"],
      "additionalProperties": false,
      "properties": {
        "integrated_lufs": { "type": ["number", "null"] },
        "true_peak_dbtp": { "type": ["number", "null"] },
        "sample_peak_dbfs": { "type": ["number", "null"] },
        "loudness_range_lu": { "type": ["number", "null"] },
        "plr_db": { "type": ["number", "null"] },
        "seconds": { "type": "number", "minimum": 0 },
        "meter": { "type": "string" },
        "valid": { "type": "boolean" }
      }
    }
  }
}
